#!/usr/bin/env bash
# A stand-in for devbox-core, spawned by the tests through DEVBOX_CORE.
#
# It answers the same JSON the real core answers and narrates itself the same way — `==>`
# per phase, `/!\` for a warning, `x` for the verdict — which is the entire protocol the
# Ink layer reads. Nothing here touches a cloud, a state or an ssh config, so a test can
# drive `up` and `down` to completion without anything existing anywhere.
set -euo pipefail
log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m/!\\\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mx\033[0m %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
  ls)
    # The version gate, refusing to be silent: the dashboard is not running this file.
    # It goes to stderr, so stdout stays the JSON the screen parses — which is the whole
    # reason the warning was invisible before there was somewhere to collect it.
    warn "devbox.example runs core 7e2a1c9, this file is 1108254 — redeploy the dashboard (cd dashboard && bun run verify first)"
    cat <<'JSON'
[{"name":"devbox-aaaa1","cloud":"hetzner","region":"hel1","instance_type":"cx33","profile":"claude","hourly_eur":0.014,"ip":"10.0.0.1","user":"dev","port":22,"local_port":9010,"app_port":9010},
 {"name":"devbox-bbbb2","cloud":"scaleway","region":"fr-par-1","instance_type":"DEV1-L","profile":"plain","hourly_eur":0.043,"ip":"10.0.0.2","user":"dev","port":22,"local_port":9011,"app_port":9011}]
JSON
    ;;
  profiles)
    cat <<'JSON'
[{"name":"plain","path":"/x/plain.sh","repo":null,"secrets":[],"note":null,"min_cpu":2,"min_ram":4,"min_disk":null,"port":null},
 {"name":"claude","path":"/x/claude.sh","repo":"https://github.com/a/b.git","secrets":["claude","github"],"note":"alice@acme.test","min_cpu":4,"min_ram":8,"min_disk":80,"port":9010}]
JSON
    ;;
  probe)
    echo '[{"hourly_eur":0.014,"cloud":"hetzner","type":"cx33","location":"hel1","cpu":4,"ram_gb":8,"disk_gb":80,"cpu_class":"shared","availability":"available"}]'
    echo "not asked:" >&2
    printf '  gcp: no usable Application Default Credentials.\n' >&2
    ;;
  orphans) echo '[]' ;;
  # The real one ends in `exec ssh`, which a test may not do: what is asserted through
  # this stand-in is that the window leaves and hands the terminal over with the name on
  # the command line.
  ssh) log "ssh ${2:-}" ;;
  info)
    echo '{"name":"devbox-aaaa1","cloud":"hetzner","region":"hel1","instance_type":"cx33","profile":"claude","hourly_eur":0.014,"ip":"10.0.0.1","user":"dev","port":22,"local_port":9010,"app_port":9010,"fingerprint":"SHA256:abc","note":"alice@acme.test","kube_port":16443}'
    ;;
  up)
    log "profile claude — https://github.com/a/b.git"
    warn "cx33 is out in fsn1 after all, next offer"
    log "ordering cx33 in hel1 at 0,014 EUR/h"
    echo "hcloud_server.this: Creating..."
    log "done in 0 min 5s"
    echo "  devbox-aaaa1 — hetzner / hel1 / cx33 — 0,014 €/h"
    ;;
  down)
    # `resolve` in the core: with several machines and no name, it refuses rather than
    # guess, because picking the wrong target here is the mistake that destroys work.
    [ -n "${2:-}" ] || die "several machines — name one: devbox-aaaa1 devbox-bbbb2"
    log "$2 destroyed. Meter stopped."
    ;;
  seed)
    log "asking Hetzner what it can create right now"
    echo "Error: resource_unavailable"
    die "every creatable offer refused the order"
    ;;
  *) die "unknown command: ${1:-} (up, seed, info, ls, profiles, probe, orphans, ssh, sync, tunnel, down)" ;;
esac
